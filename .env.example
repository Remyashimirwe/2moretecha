# ------------------------------------------------------------------
# 2-MoreTechs — environment configuration
# Copy to `.env` and fill in your real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL) -----------------------------------
# From your Neon dashboard → Connection details → Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- Authentication (Auth.js / NextAuth) --------------------------
# Generate with: openssl rand -base64 32 (required outside local development).
# Local `next dev` uses a development-only fallback when this is blank.
AUTH_SECRET=""
# Create OAuth apps and use http://localhost:3000/api/auth/callback/google
# and http://localhost:3000/api/auth/callback/github as their callback URLs.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Create a Resend API key and verify the sender domain before going live.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="2MoreTechs <accounts@your-verified-domain.com>"

# --- ResellerClub API (your domain registrar/wholesaler) ----------
# ResellerClub control panel → Settings → API.
# Add YOUR SERVER IP to the API IP whitelist before going live.
# Sandbox: https://test.httpapi.com/api   Live: https://httpapi.com/api
RESELLERCLUB_USER_ID=""
RESELLERCLUB_API_KEY=""
RESELLERCLUB_API_BASE_URL="https://test.httpapi.com/api"

# Leave empty for the default (https://domaincheck.httpapi.com/api) —
# availability checks use a dedicated host.
RESELLERCLUB_DOMAINCHECK_BASE_URL=""

# auto = use the API when credentials exist, otherwise demo mode
# live = always call the API       mock = never call the API
RESELLERCLUB_MODE="auto"

# --- Storefront pricing -------------------------------------------
# Currency you display/sell in (must match your ResellerClub selling currency).
RESELLERCLUB_CURRENCY="USD"

# Your margin on top of your ResellerClub cost price, in percent.
# retail = cost × (1 + percent/100). 20 = +20%.
DOMAIN_RETAIL_MARKUP_PERCENT="20"

# Extensions checked when a customer searches a bare keyword.
DOMAIN_SEARCH_TLDS="com,net,org,info,co"

# --- Payments (PayPal) --------------------------------------------
# PayPal Developer → My Apps & Credentials → REST API app.
# auto = use PayPal when credentials exist, otherwise simulated payments
# paypal = always PayPal        mock = never PayPal (local testing)
PAYMENT_MODE="auto"
PAYPAL_MODE="sandbox"                 # sandbox | live
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Public origin of this site (used for PayPal return/webhook URLs).
APP_URL="http://localhost:3000"
# Webhook id from PayPal Dashboard → Webhooks (enables webhook verification).
PAYPAL_WEBHOOK_ID=""

# WHOIS privacy on registrations (extra cost — keep false unless you want it).
DOMAIN_PRIVACY="false"

# --- Domain registration defaults ---------------------------------
# Name servers assigned to newly registered domains (your branded NS or
# ResellerClub defaults). Comma separated, max 2-13.
DOMAIN_DEFAULT_NS="ns1.resellerclub.com,ns2.resellerclub.com"
